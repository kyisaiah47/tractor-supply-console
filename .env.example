# Postgres from docker-compose.yml
DATABASE_URL=postgres://supply:supply@localhost:5433/supply

# The planning date. Empty means the day `npm run db:setup` ran: every dataset date moves
# forward so the last row is the day before. Set YYYY-MM-DD to pin another day, then re-run db:setup.
APP_AS_OF=

# Base URL the supply worker uses to reach the mock supplier APIs.
APP_URL=http://localhost:3000

# LLM provider for the chatbot and the weekly brief: anthropic | gemini | offline.
# Leave empty to auto-select: anthropic if ANTHROPIC_API_KEY is set, then gemini
# if GEMINI_API_KEY is set, otherwise offline (a deterministic tool router, no key needed).
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google AI Studio keys have a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
