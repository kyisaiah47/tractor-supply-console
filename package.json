{
  "name": "tractor-supply-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,worker,web -c yellow,magenta,cyan --kill-others-on-fail \"npm run api\" \"npm run worker\" \"next dev\"",
    "dev:web": "next dev",
    "api": "uv --directory backend run supply serve --reload",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "data:generate": "uv --directory backend run supply generate",
    "db:seed": "uv --directory backend run supply seed",
    "db:setup": "uv --directory backend run supply setup",
    "job:weekly": "uv --directory backend run supply weekly",
    "test": "uv --directory backend run pytest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
