{
  "name": "tractor-supply-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"tsx watch scripts/worker.ts\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start\" \"tsx scripts/worker.ts\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "data:generate": "tsx scripts/generate-data.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run data:generate && npm run db:seed",
    "job:weekly": "tsx scripts/weekly-job.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
